{
  "name": "autoparts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:db",
    "test:unit": "pnpm -r --filter \"!@autoparts/db\" test",
    "test:db": "pnpm --filter @autoparts/db test && pnpm --filter @autoparts/api test:integration",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @autoparts/db migrate",
    "db:new": "pnpm --filter @autoparts/db new",
    "db:codegen": "pnpm --filter @autoparts/db codegen",
    "tenant:create": "pnpm --filter @autoparts/api tenant:create",
    "test:e2e": "pnpm --filter @autoparts/e2e test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
