# Local development only. Copy to .env; never commit real credentials.

# Superuser of the local postgres container (bootstrap only).
POSTGRES_PASSWORD=postgres_dev_pw

# Roles created by db/bootstrap/00-roles.sh.
AUTOPARTS_OWNER_PASSWORD=owner_dev_pw
AUTOPARTS_APP_PASSWORD=app_dev_pw

# Migrations and codegen run as the owner role.
DATABASE_URL=postgres://autoparts_owner:owner_dev_pw@localhost:5432/autoparts?sslmode=disable
# The API connects as the app role (no BYPASSRLS, owns nothing).
APP_DATABASE_URL=postgres://autoparts_app:app_dev_pw@localhost:5432/autoparts?sslmode=disable

# DB tests recreate this database on every run.
TEST_DATABASE_URL=postgres://autoparts_owner:owner_dev_pw@localhost:5432/autoparts_test?sslmode=disable
TEST_APP_DATABASE_URL=postgres://autoparts_app:app_dev_pw@localhost:5432/autoparts_test?sslmode=disable

API_HOST=127.0.0.1
API_PORT=3000
