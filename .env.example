# Local development only. Copy to .env; never commit real credentials.
# Superuser connection, used only by `pnpm db:bootstrap` / `pnpm db:reset` and test setup.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Owns the schema; runs migrations. Subject to RLS (FORCE) like everyone else.
OWNER_DATABASE_URL=postgres://autoparts_owner:dev_owner_password@localhost:5432/autoparts
# Runtime role for the API: NOSUPERUSER NOBYPASSRLS, no DELETE anywhere.
APP_DATABASE_URL=postgres://autoparts_app:dev_app_password@localhost:5432/autoparts
