{
  "name": "@autoparts/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "tenant:create": "tsx src/cli/tenant-create.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@autoparts/db": "workspace:*",
    "@autoparts/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "dbmate": "^2.36.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "exports": {
    "./provisioning": "./src/provisioning.ts"
  }
}
